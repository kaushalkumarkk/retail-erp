{
  "name": "retailer-erp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run start",
    "build": "npm run build:ui && electron-builder",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:offline": "npm run build:ui && ERP_TEST_PRODUCTION=1 playwright test",
    "dev:web": "vite --host 127.0.0.1",
    "start": "npm run build:ui && electron .",
    "build:ui": "vite build",
    "desktop:pack": "npm run build:ui && electron-builder --dir",
    "test:desktop": "npm run build:ui && node --test tests/desktop.test.cjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.8"
  },
  "main": "electron/main.cjs",
  "description": "Offline retailer desktop billing, inventory and accounting",
  "author": "DevNexa"
}
